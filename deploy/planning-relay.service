[Unit]
Description=Synchro du planning de Charlène vers l'agenda d'Abview
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=rudya
Group=rudya
Environment=HOME=/home/rudya
WorkingDirectory=/home/rudya/planning-relay
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml run --rm relay
# 3 essais de connexion espacés de 5 min au pire
TimeoutStartSec=20min
